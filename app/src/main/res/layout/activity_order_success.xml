<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/btnBackToHomeIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_revert"
        android:background="@drawable/shape_icon_circle"
        android:backgroundTint="#F0E8E8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#000000"
        android:elevation="2dp"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Check Icon -->
            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/shape_icon_circle"
                android:backgroundTint="#F0E8E8" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="-60dp"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="#7B1C1C" />

            <!-- Success Message -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Pedido Enviado!"
                android:textColor="#000000"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Sua solicitação foi processada com\nsucesso."
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Order Number Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NÚMERO DO PEDIDO"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="#0042"
                        android:textColor="#7B1C1C"
                        android:textSize="36sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/shape_badge_destaque"
                android:backgroundTint="#FFF5E1"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Recebido pela cozinha"
                android:textColor="#B0893F"
                android:textSize="14sp"
                app:drawableStartCompat="@android:drawable/ic_menu_edit"
                app:drawableTint="#B0893F" />

            <!-- Stepper Tracker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivStepRecebido"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/shape_icon_circle"
                        android:backgroundTint="#7B1C1C"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#FFFFFF" />
                    <TextView
                        android:id="@+id/tvStepRecebido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Recebido"
                        android:textColor="#7B1C1C"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:id="@+id/vLine1"
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="18dp"
                    android:background="#DDDDDD" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivStepPreparando"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/shape_icon_circle"
                        android:backgroundTint="#F0E8E8"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#888888" />
                    <TextView
                        android:id="@+id/tvStepPreparando"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Em Preparo"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/vLine2"
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="18dp"
                    android:background="#DDDDDD" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivStepPronto"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/shape_icon_circle"
                        android:backgroundTint="#F0E8E8"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="#888888" />
                    <TextView
                        android:id="@+id/tvStepPronto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pronto"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:id="@+id/vLine3"
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="18dp"
                    android:background="#DDDDDD" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/ivStepEntregue"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/shape_icon_circle"
                        android:backgroundTint="#F0E8E8"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="#888888" />
                    <TextView
                        android:id="@+id/tvStepEntregue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Entregue"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- btnTrackOrder mantido apenas por compatibilidade, oculto por padrão -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrackOrder"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#7B1C1C"
                android:text="Ver Status do Pedido"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="240dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Avaliar Refeição"
                android:textAllCaps="false"
                android:textColor="#7B1C1C"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="#7B1C1C"
                app:strokeWidth="1dp"
                app:icon="@android:drawable/btn_star_big_off"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
